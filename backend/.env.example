APP_NAME="Email Campaigns"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Docker Compose API: http://localhost:8000
# Herd local site (optional): http://backend.test
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Docker Compose: mysql. Herd against published MySQL: 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=email_campaigns
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (ADR-0012). `log` writes messages to storage/logs/laravel.log and sends nothing.
# Switch to `smtp` and fill in one of the blocks below. Restart the queue worker after changes:
#   docker compose restart queue
#
# Mailtrap sandbox (Email Testing > Inboxes > SMTP credentials):
#   MAIL_MAILER=smtp  MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525  MAIL_SCHEME=null
#   MAIL_SEND_INTERVAL_MS=1000   (the free sandbox rejects bursts)
# Mailtrap Email Sending (real inbox). Username is always "api"; password is the sending API token.
#   MAIL_MAILER=smtp  MAIL_HOST=live.smtp.mailtrap.io  MAIL_PORT=587  MAIL_SCHEME=smtp
#   MAIL_USERNAME=api  MAIL_PASSWORD=<api token>  MAIL_FROM_ADDRESS=hello@demomailtrap.co
#   MAIL_TEST_TO=you@example.com   (php artisan send-mail)
# A demo from-address only delivers to the Mailtrap account owner.
# Company SMTP, STARTTLS on 587 (Microsoft 365: smtp.office365.com, Google Workspace: smtp.gmail.com with an app password):
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.example.com  MAIL_PORT=587  MAIL_SCHEME=null
# Implicit TLS on 465: MAIL_PORT=465  MAIL_SCHEME=smtps
# MAIL_FROM_ADDRESS must be an address the SMTP account is allowed to send as.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=campaigns@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=30
MAIL_SEND_INTERVAL_MS=0
MAIL_TEST_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
